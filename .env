# Environment variables for the Merchant API application
ASPNETCORE_ENVIRONMENT=Development

# Connection string
ConnectionStrings__RommieDb=Host=trpr.database;Port=5432;Database=trpr;Username=postgres;Password=postgres;
ConnectionStrings__McpEndpoint=http://trpr.mcp:3001
# Authentication
Authentication__Audience=account
Authentication__MetadataAddress=http://trpr.identity:8080/realms/rommie/.well-known/openid-configuration
Authentication__RequireHttpsMetadata=false

# Token Validation Parameters
Authentication__TokenValidationParameters__ValidIssuers__0=http://localhost:18080/realms/rommie
Authentication__TokenValidationParameters__ValidIssuers__1=http://trpr.identity:8080/realms/rommie

# OutBox
Users__OutBox__Enabled=true
Users__OutBox__BatchSize=100
Users__OutBox__TimeSpanInSeconds=30

Notifications__OutBox__Enabled=true
Notifications__OutBox__BatchSize=100
Notifications__OutBox__TimeSpanInSeconds=30

Trips__OutBox__Enabled=true
Trips__OutBox__BatchSize=100
Trips__OutBox__TimeSpanInSeconds=30

Conversations__OutBox__Enabled=true
Conversations__OutBox__BatchSize=100
Conversations__OutBox__TimeSpanInSeconds=30

Users__TokenExpirationInMinutes__Otp=60 
Users__TokenExpirationInMinutes__ForgetPasswordOtp=60 

# InBox
Users__InBox__Enabled=true
Users__InBox__BatchSize=100
Users__InBox__TimeSpanInSeconds=30

Notifications__InBox__Enabled=true
Notifications__InBox__BatchSize=100
Notifications__InBox__TimeSpanInSeconds=30

Trips__InBox__Enabled=true
Trips__InBox__BatchSize=100
Trips__InBox__TimeSpanInSeconds=30

Conversations__InBox__Enabled=true
Conversations__InBox__BatchSize=100
Conversations__InBox__TimeSpanInSeconds=30

# KeyCloak Configuration
Users__KeyCloak__AdminUrl=http://trpr.identity:8080/admin/realms/rommie/
Users__KeyCloak__TokenUrl=http://trpr.identity:8080/realms/rommie/protocol/openid-connect/token
Users__KeyCloak__ConfidentialClientId=rommie-confidential-client
Users__KeyCloak__ConfidentialClientSecret=rO4xRoiYtfARePWXa8AUlEFuX9nhT8b1
Users__KeyCloak__PublicClientId=rommie-public-client

# Yarp Routes
ReverseProxy__Clusters__cluster1__Destinations__dest1__Address=http://trpr.backend:8080
Minio__Endpoint=trpr.minio:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin123
Minio__UseSSL=false
Minio__Bucket=uploads
Minio__PublicEndpoint=localhost:9000



# Trips Routing Configuration
Trips__UseMockRoutingService=true
Trips__RoutingEngine__Driving=http://localhost:5001/route/v1/foot/
Trips__RoutingEngine__Walking=http://localhost:5000/route/v1/driving/"
